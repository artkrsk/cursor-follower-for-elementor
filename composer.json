{
  "name": "arts/cursor-follower",
  "description": "Interactive mouse cursor effects for Elementor.",
  "version": "1.0.4",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Artem Semkin",
      "email": "me@artemsemkin.com",
      "homepage": "https://artemsemkin.com"
    }
  ],
  "homepage": "https://artemsemkin.com/plugins/cursor-follower-for-elementor/",
  "wordpress": {
    "Requires at least": "6.2",
    "Tested up to": "7.1",
    "Requires PHP": "8.0"
  },
  "plugin": {
    "Plugin Name": "Arts Cursor Follower for Elementor",
    "Plugin URI": "https://artemsemkin.com/plugins/cursor-follower-for-elementor/",
    "Description": "Interactive mouse cursor effects for Elementor.",
    "Text Domain": "cursor-follower-for-elementor",
    "License": "GPLv3",
    "License URI": "https://www.gnu.org/licenses/gpl-3.0"
  },
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "Arts\\CursorFollower\\": "src/php/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "optimize-autoloader": true
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=1G",
    "pre-autoload-dump": [
      "@php -r \"is_dir('vendor-prefixed') || mkdir('vendor-prefixed');\""
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "arts/elementor-stubs": "^4.0"
  }
}
