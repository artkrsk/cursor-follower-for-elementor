{
  "name": "@arts/cursor-follower",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "types": "./dist/types/src/ts/index.d.ts",
  "exports": {
    ".": {
      "arts-source": "./src/ts/index.ts",
      "types": "./dist/types/src/ts/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./contract": {
      "arts-source": "./src/ts/contract.ts",
      "types": "./dist/types/src/ts/contract.d.ts",
      "import": "./dist/esm/contract.js",
      "default": "./dist/esm/contract.js"
    },
    "./gate": {
      "arts-source": "./src/ts/gateEntry.ts",
      "types": "./dist/types/src/ts/gateEntry.d.ts",
      "import": "./dist/esm/gate.js",
      "default": "./dist/esm/gate.js"
    },
    "./styles.scss": "./src/styles/index.scss",
    "./styles.css": "./dist/esm/styles.css",
    "./src/ts/*": "./src/ts/*",
    "./src/styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": ["src/ts", "src/styles", "dist/esm", "dist/types", "composer.json"],
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev": "vitepress dev docs --port 5200",
    "dev:plugin": "arts-wp dev",
    "build": "arts-wp build",
    "build:library": "node scripts/build-library.mjs",
    "release": "arts-wp release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@arts/wp-plugin-tooling": "github:artkrsk/wp-plugin-tooling",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fallow": "3.31.0",
    "esbuild": "^0.28.1",
    "happy-dom": "20.14.5",
    "knip": "6.39.0",
    "lefthook": "^2.1.10",
    "sass": "^1.101.0",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.3"
  }
}
